# Copy to .env and supply the values from your Aiven service's Overview page.
DB_HOST="your-service.aivencloud.com"
DB_USER="avnadmin"
DB_PASSWORD="replace-with-your-database-password"
DB_NAME="defaultdb"
DB_PORT=26795

# REQUIRED: encryption; VERIFY_IDENTITY: encryption and server authentication.
# Download the CA from Aiven to use VERIFY_IDENTITY. Relative paths use the legacy project root.
# DISABLED is available for a local development MySQL server without TLS.
DB_SSL_MODE="REQUIRED"
DB_SSL_CA=""

# Shared recording playback in leaderboard/history. Keep the secret key server-side.
RECORDING_STORAGE="supabase"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace-with-your-server-key"
SUPABASE_RECORDINGS_BUCKET="karaoke-recordings"

# Absolute path to an installed FFmpeg executable, e.g. C:/ffmpeg/bin/ffmpeg.exe.
# Leave empty only if legacy/tools/bin/ffmpeg.exe already exists.
FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
